FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps useful for OpenCV + camera tooling
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    v4l-utils \
    libportaudio2 \
    portaudio19-dev \
    libasound2 \
    libglib2.0-0 \
    libgl1 \
    build-essential \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies and package (needs `src` so that `pmai_core` exists)
COPY pmai-mai-core/pyproject.toml pmai-mai-core/README.md pmai-mai-core/LICENSE pmai-mai-core/src/ /app/
RUN python -m pip install --upgrade pip && pip install -e ".[dev]"

COPY pmai-model-context /tmp/model-context
COPY pmai-model-vision-language /tmp/action-model
RUN pip install /tmp/model-context /tmp/action-model

# Source is also bind-mounted in docker-compose for live dev, but the
# package is already installed in site-packages so `python -m pmai_core`
# works even without the volume.
CMD ["python", "-m", "pmai_core", "/app/settings.toml"]
